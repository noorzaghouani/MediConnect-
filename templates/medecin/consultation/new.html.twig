<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouvelle Consultation - MediConnect</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/medecin/medecin_dashboard.css') }}">
    <link rel="stylesheet" href="{{ asset('css/medecin/dossier.css') }}">
</head>
<body>
    {% include 'medecin/_sidebar.html.twig' %}

    <main class="main-content">
        <header class="header">
            <div class="header-left">
                <h1><i class="fas fa-stethoscope"></i> Nouvelle Consultation</h1>
                <p>Enregistrer une nouvelle consultation médicale</p>
            </div>
            <div class="header-right">
                <a href="{{ path('app_medecin_patients') }}" class="header-btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Annuler
                </a>
            </div>
        </header>

        <!-- Patient & RDV Info -->
        <div class="rdv-info-card">
            <div class="rdv-info-section">
                <div class="info-item">
                    <i class="fas fa-user"></i>
                    <div>
                        <label>Patient</label>
                        <strong>{{ patient.nom|upper }} {{ patient.prenom }}</strong>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fas fa-calendar"></i>
                    <div>
                        <label>Date RDV</label>
                        <strong>{{ rendezVous.dateHeure|date('d/m/Y à H:i') }}</strong>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fas fa-clock"></i>
                    <div>
                        <label>Durée</label>
                        <strong>20 minutes</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Consultation Form -->
        <div class="panel">
            <form method="POST" action="{{ path('app_consultation_new', {'id': rendezVous.id}) }}">
                
                <!-- Anamnèse Section -->
                <div class="consultation-section-header">
                    <i class="fas fa-notes-medical"></i>
                    <h3>Anamnèse</h3>
                </div>
                <div class="form-grid">
                    <div class="form-group-full">
                        <label for="motif" class="required">
                            <i class="fas fa-question-circle"></i> Motif de consultation
                        </label>
                        <textarea id="motif" name="motif" class="form-control" rows="2" required placeholder="Ex: Consultation de suivi, Douleurs abdominales..."></textarea>
                    </div>

                    <div class="form-group-full">
                        <label for="symptomes">
                            <i class="fas fa-thermometer-half"></i> Symptômes
                        </label>
                        <textarea id="symptomes" name="symptomes" class="form-control" rows="2" placeholder="Fièvre, toux, fatigue, maux de tête..."></textarea>
                    </div>

                    <div class="form-group-full">
                        <label for="allergies">
                            <i class="fas fa-exclamation-triangle"></i> Allergies
                        </label>
                        <textarea id="allergies" name="allergies" class="form-control" rows="2" placeholder="Allergies médicamenteuses, alimentaires..."></textarea>
                    </div>
                </div>

                <!-- Constantes Vitales Section -->
                <div class="consultation-section-header">
                    <i class="fas fa-heartbeat"></i>
                    <h3>Constantes Vitales</h3>
                </div>
                <div class="form-grid vitals-grid">
                    <div class="form-group">
                        <label for="tension">
                            <i class="fas fa-tachometer-alt"></i> Tension artérielle
                        </label>
                        <input type="text" id="tension" name="tension" class="form-control" placeholder="120/80">
                        <small class="form-text">mmHg</small>
                    </div>

                    <div class="form-group">
                        <label for="temperature">
                            <i class="fas fa-thermometer-half"></i> Température
                        </label>
                        <input type="number" step="0.1" id="temperature" name="temperature" class="form-control" placeholder="37.0">
                        <small class="form-text">°C</small>
                    </div>

                    <div class="form-group">
                        <label for="frequence_cardiaque">
                            <i class="fas fa-heartbeat"></i> Fréquence cardiaque
                        </label>
                        <input type="number" id="frequence_cardiaque" name="frequence_cardiaque" class="form-control" placeholder="72">
                        <small class="form-text">bpm</small>
                    </div>
                </div>

                <!-- Bilan Section -->
                <div class="consultation-section-header">
                    <i class="fas fa-clipboard-check"></i>
                    <h3>Bilan</h3>
                </div>
                <div class="form-grid">
                    <div class="form-group-full">
                        <label for="diagnostic" class="required">
                            <i class="fas fa-stethoscope"></i> Diagnostic
                        </label>
                        <textarea id="diagnostic" name="diagnostic" class="form-control" rows="4" required placeholder="Diagnostic médical détaillé"></textarea>
                    </div>

                    <div class="form-group-full">
                        <label for="observations">
                            <i class="fas fa-comment-medical"></i> Observations & Recommandations
                        </label>
                        <textarea id="observations" name="observations" class="form-control" rows="3" placeholder="Observations complémentaires, recommandations..."></textarea>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-save-consultation">
                        <i class="fas fa-check"></i> Enregistrer la Consultation
                    </button>
                    <a href="{{ path('app_medecin_patients') }}" class="btn-cancel-consultation">
                        <i class="fas fa-times"></i> Annuler
                    </a>
                </div>
            </form>
        </div>
    </main>
</body>
</html>
