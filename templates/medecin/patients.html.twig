{% extends 'base.html.twig' %}

{% block title %}Mes Patients - MediConnect{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/common/variables.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/sidebar.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/buttons.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/cards.css') }}">
    <link rel="stylesheet" href="{{ asset('css/medecin/medecin_dashboard.css') }}">
    <link rel="stylesheet" href="{{ asset('css/medecin/patients.css') }}">
{% endblock %}

{% block custom_styles %}{% endblock %}

{% block body %}
    {% include 'medecin/_sidebar.html.twig' %}

    <main class="main-content">
        <header class="header">
            <div class="header-left">
                <h1>Mes Patients</h1>
                <p>Gérez vos patients et accédez à leur historique médical.</p>
            </div>
            <div class="header-right">
                <a href="{{ path('app_medecin_dashboard') }}" class="header-btn btn-secondary">
                    <i class="fas fa-home"></i>
                    Accueil
                </a>
            </div>
        </header>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success mt-3 mb-4">
                <i class="fas fa-check-circle"></i> {{ message }}
            </div>
        {% endfor %}

        <div class="panel">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="py-3 ps-4">Patient</th>
                            <th class="py-3 text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if patientsWithRdv is empty %}
                            <tr>
                                <td colspan="2" class="text-center py-5 text-muted">
                                    <i class="fas fa-users fa-2x mb-3"></i>
                                    <p class="mb-0">Aucun patient trouvé.</p>
                                </td>
                            </tr>
                        {% else %}
                            {% for item in patientsWithRdv %}
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3 patient-avatar-circle">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">{{ item.patient.nom|upper }} {{ item.patient.prenom }}</div>
                                                <div class="small text-muted">
                                                    <i class="fas fa-phone-alt"></i> {{ item.patient.telephone|default('Non renseigné') }}
                                                </div>
                                                <div class="small text-muted">{{ item.patient.email }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="{{ path('app_dossier_show', {'id': item.patient.id}) }}" class="action-btn btn-view me-2 no-decoration">
                                            <i class="fas fa-folder-open"></i> Dossier
                                        </a>
                                        {% if item.nextRdv %}
                                            <a href="{{ path('app_consultation_new', {'id': item.nextRdv.id}) }}" class="action-btn btn-primary no-decoration">
                                                <i class="fas fa-stethoscope"></i> Consulter
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </main>
{% endblock %}
