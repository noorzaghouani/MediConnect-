<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier Ordonnance - MediConnect</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/medecin/medecin_dashboard.css') }}">
    <link rel="stylesheet" href="{{ asset('css/medecin/ordonnance.css') }}">
</head>
<body>
    {% include 'medecin/_sidebar.html.twig' %}

    <main class="main-content">
        <header class="header">
            <div class="header-left">
                <h1><i class="fas fa-edit"></i> Modifier l'Ordonnance</h1>
                <p>{{ ordonnance.patient.nom|upper }} {{ ordonnance.patient.prenom }}</p>
            </div>
            <div class="header-right">
                <a href="{{ path('app_medecin_ordonnance_show', {'id': ordonnance.id}) }}" class="header-btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Annuler
                </a>
            </div>
        </header>

        <!-- Ordonnance Edit Form -->
        <div class="panel">
            <div class="ordonnance-form-container">
                <form method="POST" action="{{ path('app_medecin_ordonnance_edit', {'id': ordonnance.id}) }}" id="ordonnanceEditForm">
                    
                    <!-- Patient Info (readonly) -->
                    <div class="form-section">
                        <h3><i class="fas fa-user"></i> Patient</h3>
                        <div class="patient-info-readonly">
                            <div class="info-badge">
                                {{ ordonnance.patient.nom|upper }} {{ ordonnance.patient.prenom }}
                            </div>
                            <div class="text-muted small">
                                Ordonnance créée le {{ ordonnance.createdAt|date('d/m/Y à H:i') }}
                            </div>
                        </div>
                    </div>

                    <!-- Medications Section -->
                    <div class="form-section">
                        <div class="section-header-with-btn">
                            <h3><i class="fas fa-pills"></i> Médicaments Prescrits</h3>
                            <button type="button" class="btn-add-medication" onclick="addMedication()">
                                <i class="fas fa-plus"></i> Ajouter un médicament
                            </button>
                        </div>

                        <div id="medications-container">
                            <!-- Medications will be loaded from existing ordonnance -->
                        </div>
                    </div>

                    <!-- Hidden field for final formatted content -->
                    <input type="hidden" name="contenu" id="contenu">

                    <div class="form-actions">
                        <button type="submit" class="btn-save-ordonnance">
                            <i class="fas fa-check"></i> Enregistrer les Modifications
                        </button>
                        <a href="{{ path('app_medecin_ordonnance_show', {'id': ordonnance.id}) }}" class="btn-cancel-ordonnance">
                            <i class="fas fa-times"></i> Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script src="{{ asset('js/medecin/ordonnance.js') }}"></script>
    <script>
        // Parse existing ordonnance content and populate form
        document.addEventListener('DOMContentLoaded', function() {
            const existingContent = `{{ ordonnance.contenu|raw }}`;
            
            // Parse the content to extract medications
            const lines = existingContent.trim().split('\n');
            let currentMed = null;
            const medications = [];
            
            lines.forEach(line => {
                line = line.trim();
                if (!line) return;
                
                // Check if it's a medication line (starts with number)
                if (/^\d+\./.test(line)) {
                    if (currentMed) {
                        medications.push(currentMed);
                    }
                    currentMed = {
                        nom: line.replace(/^\d+\.\s*/, ''),
                        posologie: '',
                        frequence: '',
                        duree: ''
                    };
                } else if (currentMed) {
                    // Parse sub-items
                    if (line.includes('Posologie:')) {
                        currentMed.posologie = line.replace(/.*Posologie:\s*/, '').trim();
                    } else if (line.includes('Fréquence:')) {
                        currentMed.frequence = line.replace(/.*Fréquence:\s*/, '').trim();
                    } else if (line.includes('Durée:')) {
                        const match = line.match(/(\d+)/);
                        currentMed.duree = match ? match[1] : '';
                    }
                }
            });
            
            if (currentMed) {
                medications.push(currentMed);
            }
            
            // Populate form with parsed medications
            if (medications.length > 0) {
                medications.forEach((med, idx) => {
                    addMedication();
                    const medId = medicationCount;
                    
                    // Set medicament
                    const medSelect = document.querySelector(`[name="medicament_${medId}"]`);
                    const medOption = Array.from(medSelect.options).find(opt => opt.value === med.nom);
                    if (medOption) {
                        medSelect.value = med.nom;
                    } else {
                        medSelect.value = "Autre (saisie libre)";
                        handleMedicamentChange(medId);
                        document.getElementById(`custom_medicament_${medId}`).value = med.nom;
                    }
                    
                    // Set posologie
                    const posSelect = document.querySelector(`[name="posologie_${medId}"]`);
                    const posOption = Array.from(posSelect.options).find(opt => opt.value === med.posologie);
                    if (posOption) {
                        posSelect.value = med.posologie;
                    }
                    
                    // Set frequence
                    const freqSelect = document.querySelector(`[name="frequence_${medId}"]`);
                    const freqOption = Array.from(freqSelect.options).find(opt => opt.value === med.frequence);
                    if (freqOption) {
                        freqSelect.value = med.frequence;
                    }
                    
                    // Set duree
                    document.querySelector(`[name="duree_${medId}"]`).value = med.duree;
                });
            } else {
                // If parsing failed, add one empty medication
                addMedication();
            }
        });

        // Override form submit for edit form
        document.getElementById('ordonnanceEditForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const medications = document.querySelectorAll('.medication-item');
            if (medications.length === 0) {
                alert('Veuillez ajouter au moins un médicament');
                return;
            }
            
            let formattedContent = '';
            
            medications.forEach((item, index) => {
                const id = item.id.split('-')[1];
                
                let medicament = document.querySelector(`[name="medicament_${id}"]`).value;
                if (medicament === "Autre (saisie libre)") {
                    medicament = document.getElementById(`custom_medicament_${id}`).value;
                }
                
                const posologie = document.querySelector(`[name="posologie_${id}"]`).value;
                const frequence = document.querySelector(`[name="frequence_${id}"]`).value;
                const duree = document.querySelector(`[name="duree_${id}"]`).value;
                
                if (!medicament || !posologie || !frequence || !duree) {
                    alert('Veuillez remplir tous les champs obligatoires');
                    throw new Error('Missing fields');
                }
                
                formattedContent += `${index + 1}. ${medicament}\n`;
                formattedContent += `   - Posologie: ${posologie}\n`;
                formattedContent += `   - Fréquence: ${frequence}\n`;
                formattedContent += `   - Durée: ${duree} jours\n\n`;
            });
            
            document.getElementById('contenu').value = formattedContent.trim();
            this.submit();
        });
    </script>
</body>
</html>
