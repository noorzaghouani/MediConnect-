<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouvelle Ordonnance - MediConnect</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/medecin/medecin_dashboard.css') }}">
    <link rel="stylesheet" href="{{ asset('css/medecin/ordonnance.css') }}">
</head>
<body>
    {% include 'medecin/_sidebar.html.twig' %}

    <main class="main-content">
        <header class="header">
            <div class="header-left">
                <h1><i class="fas fa-plus-circle"></i> Nouvelle Ordonnance</h1>
                <p>Créer une ordonnance pour un patient</p>
            </div>
            <div class="header-right">
                <a href="{{ path('app_medecin_ordonnances') }}" class="header-btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>
        </header>

        <!-- Ordonnance Form -->
        <div class="panel">
            <div class="ordonnance-form-container">
                <form method="POST" action="{{ path('app_medecin_ordonnance_new') }}" id="ordonnanceForm">
                    
                    <!-- Patient Selection -->
                    <div class="form-section">
                        <h3><i class="fas fa-user"></i> Sélectionner le Patient</h3>
                        <div class="form-group-full">
                            <label for="patient_id" class="required">Patient</label>
                            <select id="patient_id" name="patient_id" class="form-control" required>
                                <option value="">-- Choisir un patient --</option>
                                {% for patient in patients %}
                                    <option value="{{ patient.id }}">{{ patient.nom|upper }} {{ patient.prenom }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <!-- Medications Section -->
                    <div class="form-section">
                        <div class="section-header-with-btn">
                            <h3><i class="fas fa-pills"></i> Médicaments Prescrits</h3>
                            <button type="button" class="btn-add-medication" onclick="addMedication()">
                                <i class="fas fa-plus"></i> Ajouter un médicament
                            </button>
                        </div>

                        <div id="medications-container">
                            <!-- Medications will be added here dynamically -->
                        </div>
                    </div>

                    <!-- Hidden field for final formatted content -->
                    <input type="hidden" name="contenu" id="contenu">

                    <div class="form-actions">
                        <button type="submit" class="btn-save-ordonnance">
                            <i class="fas fa-check"></i> Créer l'Ordonnance
                        </button>
                        <a href="{{ path('app_medecin_ordonnances') }}" class="btn-cancel-ordonnance">
                            <i class="fas fa-times"></i> Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script src="{{ asset('js/medecin/ordonnance.js') }}"></script>
</body>
</html>
