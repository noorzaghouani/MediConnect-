<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mes Ordonnances - MediConnect</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/medecin/medecin_dashboard.css') }}">
    <link rel="stylesheet" href="{{ asset('css/medecin/ordonnance.css') }}">
</head>
<body>
    {% include 'medecin/_sidebar.html.twig' %}

    <main class="main-content">
        <header class="header">
            <div class="header-left">
                <h1><i class="fas fa-file-prescription"></i> Mes Ordonnances</h1>
                <p>Gérer et consulter les ordonnances prescrites</p>
            </div>
            <div class="header-right">
                <a href="{{ path('app_medecin_ordonnance_new') }}" class="header-btn btn-primary">
                    <i class="fas fa-plus"></i> Nouvelle Ordonnance
                </a>
            </div>
        </header>

        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mt-3 mb-4">
                <i class="fas fa-check-circle"></i> {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-error mt-3 mb-4">
                <i class="fas fa-exclamation-circle"></i> {{ message }}
            </div>
        {% endfor %}

        <!-- Ordonnances List -->
        <div class="panel">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="py-3 ps-4">Patient</th>
                            <th class="py-3">Date de création</th>
                            <th class="py-3">Aperçu</th>
                            <th class="py-3 text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if ordonnances is empty %}
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="fas fa-file-prescription fa-2x mb-3"></i>
                                    <p class="mb-0">Aucune ordonnance trouvée.</p>
                                </td>
                            </tr>
                        {% else %}
                            {% for ordonnance in ordonnances %}
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3 ordonnance-avatar-circle">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">{{ ordonnance.patient.nom|upper }} {{ ordonnance.patient.prenom }}</div>
                                                {% if ordonnance.consultation %}
                                                    <div class="small text-muted">
                                                        <i class="fas fa-link"></i> Consultation {{ ordonnance.consultation.date|date('d/m/Y') }}
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <i class="fas fa-calendar"></i> {{ ordonnance.createdAt|date('d/m/Y') }}
                                        </div>
                                        <div class="small text-muted">{{ ordonnance.createdAt|date('H:i') }}</div>
                                    </td>
                                    <td>
                                        <div class="ordonnance-preview">
                                            {{ ordonnance.contenu|length > 80 ? ordonnance.contenu|slice(0, 80) ~ '...' : ordonnance.contenu }}
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="{{ path('app_medecin_ordonnance_show', {'id': ordonnance.id}) }}" class="action-btn btn-view me-2 no-decoration">
                                            <i class="fas fa-eye"></i> Voir
                                        </a>
                                        <a href="{{ path('app_medecin_ordonnance_edit', {'id': ordonnance.id}) }}" class="action-btn btn-edit me-2 no-decoration">
                                            <i class="fas fa-edit"></i> Modifier
                                        </a>
                                        <form method="POST" action="{{ path('app_medecin_ordonnance_delete', {'id': ordonnance.id}) }}" class="inline-form" onsubmit="return confirm('Supprimer cette ordonnance?');">
                                            <button type="submit" class="action-btn btn-delete">
                                                <i class="fas fa-trash"></i> Supprimer
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>
</html>
