<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MediConnect{% endblock %}</title>
    
    {# Bootstrap CSS - Local #}
    <link href="{{ asset('vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    
    {# Font Awesome - Local #}
    <link rel="stylesheet" href="{{ asset('vendor/fontawesome/css/all.min.css') }}">
    
    {# Google Fonts #}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    {# Styles personnalisés #}
    {% block custom_styles %}
        <link rel="stylesheet" href="{{ asset('css/base/styles.css') }}">
    {% endblock %}
    
    {% block stylesheets %}{% endblock %}

    {% if app.user %}
        <meta name="csrf-token" content="{{ csrf_token('book_rdv_js') }}">
        <meta name="csrf-token-cancel" content="{{ csrf_token('cancel_rdv_js') }}">
    {% endif %}
</head>
<body>
    {% block body %}
        {# Le contenu spécifique de chaque page viendra ici #}
    {% endblock %}

    {# Bootstrap JS - Local #}
    <script src="{{ asset('vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    
    {% block javascripts %}{% endblock %}
</body>
</html>