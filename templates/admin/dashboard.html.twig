<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Statistiques - MediConnect</title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Common Styles -->
    <link rel="stylesheet" href="{{ asset('css/common/variables.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/sidebar.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/buttons.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/cards.css') }}">
    <!-- Admin Specific Styles -->
    <link rel="stylesheet" href="{{ asset('css/admin/dashboardadmin.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin/profile_modal.css') }}">
    

</head>
<body>

    <!-- SIDEBAR -->
    {% include 'components/_sidebar.html.twig' with {
        'role': 'admin',
        'user': app.user,
        'current_route': 'app_admin_dashboard',
        'medecinsNonVerifiesCount': medecinsNonVerifies|length
    } %}

    <!-- MAIN CONTENT -->
    <main class="main-content">
        
        <!-- HEADER -->
        <header class="header">
            <div class="header-left">
                <h1>MediConnect Admin</h1>
            </div>
            <div class="header-right">
                <button class="header-btn btn-edit-profile">
                    <i class="fas fa-user-edit"></i>
                    Éditer Profil
                </button>
                <a href="{{ path('app_logout') }}" class="header-btn btn-logout">
                    <i class="fas fa-sign-out-alt"></i>
                    Déconnexion
                </a>
            </div>
        </header>

        <!-- DASHBOARD CONTENT -->
        
        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> {{ message }}
            </div>
        {% endfor %}

        <!-- Stats Grid (KPIs) -->
        <h2 class="stats-heading">Analyse & Statistiques</h2>
        <div class="stats-grid">
            <!-- Card 1: Patients -->
            <div class="stat-card">
                <div class="stat-icon-box icon-blue">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Patients</span>
                    <span class="stat-value">{{ nbPatients|number_format(0, ',', ' ') }}</span>
                </div>
            </div>
            
            <!-- Card 2: Médecins -->
            <div class="stat-card">
                <div class="stat-icon-box icon-green">
                    <i class="fas fa-user-md"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Médecins</span>
                    <span class="stat-value">{{ nbMedecins|number_format(0, ',', ' ') }}</span>
                </div>
            </div>
            
            <!-- Card 3: Consultations -->
            <div class="stat-card">
                <div class="stat-icon-box icon-orange">
                    <i class="fas fa-file-medical-alt"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Consultations</span>
                    <span class="stat-value">{{ nbConsultations|number_format(0, ',', ' ') }}</span>
                </div>
            </div>
            
            <!-- Card 4: Demandes (Link to new page) -->
            <a href="{{ path('app_admin_demandes') }}" class="link-no-style">
                <div class="stat-card clickable-card">
                    <div class="stat-icon-box icon-red">
                        <i class="fas fa-bell"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-label">Demandes en attente</span>
                        <span class="stat-value">{{ medecinsNonVerifies|length }}</span>
                    </div>
                    {% if medecinsNonVerifies|length > 0 %}
                    <i class="fas fa-arrow-right arrow-icon-red"></i>
                    {% endif %}
                </div>
            </a>
        </div>

        <!-- NEW CHARTS SECTION (V2 Design) -->
        <div class="charts-container">
            <!-- Line Chart: TODAY'S ACTIVITY (HOURLY) -->
            <div class="chart-card">
                <div class="chart-header">
                    <div class="chart-title">
                        <i class="fas fa-clock chart-icon"></i>
                        Consultations par Jour
                    </div>
                    <div class="chart-subtitle">Activité quotidienne</div>
                </div>
                <div class="canvas-container">
                    <canvas id="lineChart" 
                            data-consultations="{{ consultationsParJour|json_encode|e('html_attr') }}"
                            data-labels="{{ labelsJours|json_encode|e('html_attr') }}"></canvas>
                </div>
            </div>

            <!-- Doughnut Chart: COLORFUL -->
            <div class="chart-card">
                <div class="chart-header">
                    <div class="chart-title">
                        <i class="fas fa-briefcase-medical chart-icon"></i>
                        Répartition Spécialités
                    </div>
                    <div class="chart-subtitle">Médecins vérifiés</div>
                </div>
                <div class="canvas-container">
                    <canvas id="doughnutChart" data-repartition="{{ repartitionSpecialites|json_encode|e('html_attr') }}"></canvas>
                </div>
            </div>
        </div>
        
    </main>

    <!-- ADMIN PROFILE MODAL -->
    {% include 'admin/_profile_modal.html.twig' %}

    <!-- External Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="{{ asset('js/admin/dashboard_stats.js') }}"></script>
    <script src="{{ asset('js/admin/profile_modal.js') }}"></script>
</body>
</html>
