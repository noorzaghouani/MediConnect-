<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Demandes d'Inscription - MediConnect</title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Common Styles -->
    <link rel="stylesheet" href="{{ asset('css/common/variables.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/sidebar.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/buttons.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/cards.css') }}">
    <!-- Admin Specific Styles -->
    <link rel="stylesheet" href="{{ asset('css/admin/dashboardadmin.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin/profile_modal.css') }}">
</head>
<body>

    <!-- SIDEBAR -->
    {% include 'components/_sidebar.html.twig' with {
        'role': 'admin',
        'user': app.user,
        'current_route': 'app_admin_demandes',
        'medecinsNonVerifiesCount': medecinsNonVerifies|length
    } %}

    <!-- MAIN CONTENT -->
    <main class="main-content">
        
        <!-- HEADER -->
        <header class="header">
            <div class="header-left">
                <h1>MediConnect Admin</h1>
            </div>
            <div class="header-right">
                <button class="header-btn btn-edit-profile">
                    <i class="fas fa-user-edit"></i>
                    Éditer Profil
                </button>
                <a href="{{ path('app_logout') }}" class="header-btn btn-logout">
                    <i class="fas fa-sign-out-alt"></i>
                    Déconnexion
                </a>
            </div>
        </header>

        <!-- Demandes Section -->
        <div class="section-container">
            <div class="section-header">
                <h2 class="section-title">Demandes d'Inscription Médecin</h2>
                <div class="section-subtitle">({{ medecinsNonVerifies|length }} en attente)</div>
            </div>
            
            {% if medecinsNonVerifies is empty %}
                <div class="empty-state">
                    <div class="check-circle">
                        <i class="fas fa-check"></i>
                    </div>
                    <p class="empty-text">Aucune demande d'inscription en attente.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Médecin</th>
                                <th>Spécialité (Assignation)</th>
                                <th>Diplôme</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for medecin in medecinsNonVerifies %}
                                <tr>
                                    <td>{{ loop.index }}</td>
                                    <td>
                                        <div class="font-weight-bold">Dr. {{ medecin.prenom }} {{ medecin.nom }}</div>
                                        <div class="info-text">{{ medecin.email }}</div>
                                    </td>
                                    <td>
                                        <form action="{{ path('app_admin_valider_medecin', {'id': medecin.id}) }}" 
                                              method="post" 
                                              id="form-approve-{{ medecin.id }}">
                                            <select name="specialite" required class="select-field">
                                                <option value="">-- Choisir Spécialité --</option>
                                                {% for spec in specialites %}
                                                    <option value="{{ spec.id }}">{{ spec.nom }}</option>
                                                {% endfor %}
                                            </select>
                                        </form>
                                    </td>
                                    <td>
                                        {% if medecin.diplome %}
                                            <a href="{{ asset('uploads/diplomes/' ~ medecin.diplome) }}" target="_blank" class="btn btn-view" title="Voir Diplôme">
                                                <i class="fas fa-eye"></i> Voir
                                            </a>
                                        {% else %}
                                            <span class="info-text">Aucun</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <button type="submit" form="form-approve-{{ medecin.id }}" class="btn btn-approve" title="Valider">
                                                <i class="fas fa-check"></i> Approuver
                                            </button>
                                            
                                            <form action="{{ path('app_admin_refuser_medecin', {'id': medecin.id}) }}" 
                                                  method="post" 
                                                  onsubmit="return confirm('Voulez-vous vraiment refuser ce médecin ?');"
                                                  class="inline-form">
                                                <button type="submit" class="btn btn-reject" title="Refuser">
                                                    <i class="fas fa-times"></i> Rejeter
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
        
    </main>

    </main>

    <!-- ADMIN PROFILE MODAL -->
    {% include 'admin/_profile_modal.html.twig' %}
    <script src="{{ asset('js/admin/profile_modal.js') }}"></script>
</body>
</html>
