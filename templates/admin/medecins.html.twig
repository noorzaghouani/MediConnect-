<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liste des Médecins - MediConnect Admin</title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Common Styles -->
    <link rel="stylesheet" href="{{ asset('css/common/variables.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/sidebar.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/buttons.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/cards.css') }}">
    <!-- Admin Specific Styles -->
    <link rel="stylesheet" href="{{ asset('css/admin/dashboardadmin.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin/medecinadmin.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin/profile_modal.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin/delete_modal.css') }}">
</head>
<body>

    <!-- SIDEBAR -->
    {% include 'components/_sidebar.html.twig' with {
        'role': 'admin',
        'user': app.user,
        'current_route': 'app_admin_medecins',
        'medecinsNonVerifiesCount': medecinsNonVerifiesCount
    } %}

    <!-- MAIN CONTENT -->
    <main class="main-content">
        
        <!-- HEADER -->
        <header class="header">
            <div class="header-left">
                <h1>MediConnect Admin</h1>
            </div>
            <div class="header-right">
                <button class="header-btn btn-edit-profile">
                    <i class="fas fa-user-edit"></i> Éditer Profil
                </button>
                <a href="{{ path('app_logout') }}" class="header-btn btn-logout">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </div>
        </header>

        <!-- DOCTOR LIST PAGE HEADER -->
        <div class="page-header-actions">
            <h2 class="section-title-large">Liste des Médecins</h2>
            
            <form action="{{ path('app_admin_medecins') }}" method="GET" class="search-bar">
                <i class="fas fa-search search-icon"></i>
                <input type="text" name="q" value="{{ searchTerm|default('') }}" class="search-input" placeholder="Recherche par nom, email, spécialité...">
                <!-- Optional: Add a hidden submit button if needed, but enter works by default -->
            </form>
        </div>

        <!-- DOCTORS TABLE -->
        <div class="section-container">
            <div class="table-responsive">
                <table class="custom-table" id="doctorsTable">
                    <thead>
                        <tr>
                            <th class="table-cell-id">#</th>
                            <th>Nom complet</th>
                            <th>Date de création</th>
                            <th class="table-cell-actions">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for medecin in medecins %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td class="font-weight-bold">Dr. {{ medecin.prenom }} {{ medecin.nom }}</td>
                                <td>{{ medecin.createdAt ? medecin.createdAt|date('d/m/Y') : 'N/A' }}</td>
                                <td class="table-cell-actions">
                                    <button class="btn btn-view" onclick="openModal('{{ medecin.prenom }} {{ medecin.nom }}', '{{ medecin.specialite ? medecin.specialite.nom : 'Non définie' }}', '{{ medecin.email }}', '{{ medecin.telephone }}')">
                                        <i class="fas fa-eye"></i> Voir
                                    </button>
                                    <button class="btn btn-delete"
                                            data-id="{{ medecin.id }}"
                                            data-csrf="{{ csrf_token('delete_medecin_' ~ medecin.id) }}"
                                            onclick="confirmDelete({{ medecin.id }}, '{{ (medecin.prenom ~ ' ' ~ medecin.nom)|e('js') }}', this)">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="table-cell-centered">
                                    Aucun résultat pour cette recherche.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- VIEWER MODAL (Teal Design) -->
    <div id="doctorModal" class="modal-overlay">
        <div class="modal-card">
            <!-- Modal Header -->
            <div class="modal-header">
                <div class="modal-title">
                    <div class="title-icon"><i class="fas fa-user-md"></i></div>
                    <span>Détails Médecin</span>
                </div>
                <button onclick="closeModal()" class="btn-close"><i class="fas fa-times"></i></button>
            </div>
            
            <!-- Modal Body -->
            <div class="modal-body">
                
                <!-- Section Title -->
                <div class="section-title">
                    <i class="fas fa-user"></i> Informations Personnelles
                </div>

                <!-- Info Container -->
                <div class="info-container">
                    
                    <div class="form-group">
                        <label class="label">Nom complet</label>
                        <div id="modalName" class="value-box">-</div>
                    </div>

                    <div class="form-group">
                        <label class="label">Spécialité</label>
                        <div id="modalSpecialty" class="value-box">-</div>
                    </div>

                    <div class="form-group">
                        <label class="label">Email</label>
                        <div id="modalEmail" class="value-box">-</div>
                    </div>

                    <div class="form-group">
                        <label class="label">Téléphone</label>
                        <div id="modalPhone" class="value-box">-</div>
                    </div>

                </div>

                <div class="modal-footer-buttons">
                    <button onclick="closeModal()" class="btn-modal-close">Fermer</button>
                </div>

            </div>
        </div>
    </div>

    <!-- DELETE CONFIRMATION MODAL -->
    <div id="deleteModal" class="modal-overlay">
        <div class="modal-card modal-delete">
            <!-- Modal Header -->
            <div class="modal-header modal-header-danger">
                <div class="modal-title">
                    <div class="title-icon"><i class="fas fa-exclamation-triangle"></i></div>
                    <span>Confirmer la suppression</span>
                </div>
                <button onclick="closeDeleteModal()" class="btn-close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <!-- Modal Body -->
            <div class="modal-body">
                <p class="delete-warning">
                    <i class="fas fa-exclamation-circle"></i>
                    Êtes-vous sûr de vouloir supprimer le compte du <strong>Dr. <span id="deleteMedecinName"></span></strong> ?
                </p>
                <p class="delete-info">Cette action est <strong>irréversible</strong>. Toutes les consultations, disponibilités et rendez-vous associés seront également supprimés.</p>
                
                <form id="deleteForm" method="POST" action="">
                    <input type="hidden" name="_token" id="deleteCsrfToken" value="">
                    <div class="modal-footer-buttons">
                        <button type="button" onclick="closeDeleteModal()" class="btn-modal-cancel">
                            Annuler
                        </button>
                        <button type="submit" class="btn-modal-delete">
                            <i class="fas fa-trash"></i> Supprimer définitivement
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ADMIN PROFILE MODAL -->
    {% include 'admin/_profile_modal.html.twig' %}

    {% if not searchTerm and totalPages > 1 %}
    <nav class="pagination-nav">
        {% if currentPage > 1 %}
            <a href="{{ path('app_admin_medecins', {'page': currentPage - 1}) }}" class="page-btn">&laquo; Précédent</a>
        {% endif %}
        <span class="page-info">Page {{ currentPage }} / {{ totalPages }}</span>
        {% if currentPage < totalPages %}
            <a href="{{ path('app_admin_medecins', {'page': currentPage + 1}) }}" class="page-btn">Suivant &raquo;</a>
        {% endif %}
    </nav>
    {% endif %}

    <!-- JavaScript for Modal -->
    <script src="{{ asset('js/admin/medecin_actions.js') }}"></script>
    <script src="{{ asset('js/admin/profile_modal.js') }}"></script>
</body>
</html>
