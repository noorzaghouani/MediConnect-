<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liste des Patients - MediConnect Admin</title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Common Styles -->
    <link rel="stylesheet" href="{{ asset('css/common/variables.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/sidebar.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/buttons.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/cards.css') }}">
    <!-- Admin Specific Styles -->
    <link rel="stylesheet" href="{{ asset('css/admin/dashboardadmin.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin/patientadmin.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin/profile_modal.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin/delete_modal.css') }}">
</head>
<body>

    <!-- SIDEBAR -->
    {% include 'components/_sidebar.html.twig' with {
        'role': 'admin',
        'user': app.user,
        'current_route': 'app_admin_patients',
        'medecinsNonVerifiesCount': medecinsNonVerifiesCount
    } %}

    <!-- MAIN CONTENT -->
    <main class="main-content">
        
        <!-- HEADER -->
        <header class="header">
            <div class="header-left">
                <h1>MediConnect Admin</h1>
            </div>
            <div class="header-right">
                <button class="header-btn btn-edit-profile">
                    <i class="fas fa-user-edit"></i> Éditer Profil
                </button>
                <a href="{{ path('app_logout') }}" class="header-btn btn-logout">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </div>
        </header>

        <!-- PATIENT LIST PAGE HEADER -->
        <div class="page-header-actions">
            <h2 class="section-title-large">Liste des Patients</h2>
            
            <form action="{{ path('app_admin_patients') }}" method="GET" class="search-bar">
                <i class="fas fa-search search-icon"></i>
                <input type="text" name="q" value="{{ searchTerm|default('') }}" class="search-input" placeholder="Filtrer par nom, email, téléphone...">
            </form>
        </div>

        <!-- PATIENTS TABLE -->
        <div class="section-container">
            <div class="table-responsive">
                <table class="custom-table" id="patientsTable">
                    <thead>
                        <tr>
                            <th class="table-cell-id">#</th>
                            <th>Nom complet</th>
                            <th>Date de création</th>
                            <th class="table-cell-actions">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for patient in patients %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td class="font-weight-bold">{{ patient.prenom }} {{ patient.nom }}</td>
                                <td>{{ patient.createdAt ? patient.createdAt|date('d/m/Y') : 'N/A' }}</td>
                                <td class="table-cell-actions">
                                    <button class="btn btn-view" onclick="openPatientModal('{{ patient.prenom }} {{ patient.nom }}', '{{ patient.email }}', '{{ patient.telephone }}')">
                                        <i class="fas fa-eye"></i> Voir
                                    </button>
                                    <button class="btn btn-delete" onclick="confirmDeletePatient({{ patient.id }}, '{{ patient.prenom }} {{ patient.nom }}')">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="table-cell-centered">
                                    Aucun patient inscrit.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- PATIENT DETAILS MODAL -->
    <div id="patientModal" class="modal-overlay">
        <div class="modal-card">
            <!-- Modal Header -->
            <div class="modal-header">
                <div class="modal-title">
                    <div class="title-icon"><i class="fas fa-user-injured"></i></div>
                    <span>Détails Patient</span>
                </div>
                <button onclick="closePatientModal()" class="btn-close"><i class="fas fa-times"></i></button>
            </div>
            
            <!-- Modal Body -->
            <div class="modal-body">
                
                <!-- Section Title -->
                <div class="modal-section-title">
                    <i class="fas fa-user"></i> Informations Personnelles
                </div>

                <!-- Info Container -->
                <div class="info-container">
                    
                    <div class="form-group">
                        <label class="label">Nom complet</label>
                        <div id="modalPatientName" class="value-box">-</div>
                    </div>

                    <div class="form-group">
                        <label class="label">Email</label>
                        <div id="modalPatientEmail" class="value-box">-</div>
                    </div>

                    <div class="form-group">
                        <label class="label">Téléphone</label>
                        <div id="modalPatientPhone" class="value-box">-</div>
                    </div>

                </div>

                <div class="modal-footer-buttons">
                    <button onclick="closePatientModal()" class="btn-modal-close">Fermer</button>
                </div>

            </div>
        </div>
    </div>

    <!-- DELETE CONFIRMATION MODAL -->
    <div id="deletePatientModal" class="modal-overlay">
        <div class="modal-card modal-delete">
            <!-- Modal Header -->
            <div class="modal-header modal-header-danger">
                <div class="modal-title">
                    <div class="title-icon"><i class="fas fa-exclamation-triangle"></i></div>
                    <span>Confirmer la suppression</span>
                </div>
                <button onclick="closeDeletePatientModal()" class="btn-close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <!-- Modal Body -->
            <div class="modal-body">
                <p class="delete-warning">
                    <i class="fas fa-exclamation-circle"></i>
                    Êtes-vous sûr de vouloir supprimer le compte de <strong><span id="deletePatientName"></span></strong> ?
                </p>
                <p class="delete-info">Cette action est <strong>irréversible</strong>. Toutes les ordonnances, dossier médical et rendez-vous associés seront également supprimés.</p>
                
                <form id="deletePatientForm" method="POST" action="">
                    <div class="modal-footer-buttons">
                        <button type="button" onclick="closeDeletePatientModal()" class="btn-modal-cancel">
                            Annuler
                        </button>
                        <button type="submit" class="btn-modal-delete">
                            <i class="fas fa-trash"></i> Supprimer définitivement
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ADMIN PROFILE MODAL -->
    {% include 'admin/_profile_modal.html.twig' %}

    <!-- JavaScript for Modals -->
    <script src="{{ asset('js/admin/patient_actions.js') }}"></script>
    <script src="{{ asset('js/admin/profile_modal.js') }}"></script>
</body>
</html>
