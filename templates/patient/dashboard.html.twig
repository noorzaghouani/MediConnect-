{% extends 'base.html.twig' %}

{% block title %}Dashboard Patient - MediConnect{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/common/variables.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/sidebar.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/buttons.css') }}">
    <link rel="stylesheet" href="{{ asset('css/common/cards.css') }}">
    <link rel="stylesheet" href="{{ asset('css/patient/patient_dashboard.css') }}?v=1">
    <link rel="stylesheet" href="{{ asset('css/common/modal.css') }}?v=1">
{% endblock %}

{% block custom_styles %}{% endblock %}

{% block body %}
    {% include 'patient/_sidebar.html.twig' %}

    <!-- Main Content -->
    <main class="main-content">
        <!-- Header -->
        <header class="header">
            <div class="header-left">
                <h1>Bienvenue, {{ app.user.prenom |upper }}</h1>
                <p class="header-date">{{ "now"|date("l d F Y", "Europe/Paris") }}</p>
            </div>
            <div class="header-right">
                <button class="header-btn btn-primary" id="editProfileBtn">
                    <i class="fas fa-user-edit"></i>
                    Éditer Profil
                </button>
                <a href="{{ path('app_logout') }}" class="header-btn btn-secondary">
                    <i class="fas fa-sign-out-alt"></i>
                    Déconnexion
                </a>
            </div>
        </header>

        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i> {{ message }}
            </div>
        {% endfor %}

        <!-- Search Section -->
        <div class="panel search-panel">
            <div class="panel-header">
                <h2 class="panel-title">
                    <i class="fas fa-search"></i>
                    Trouver un Médecin
                </h2>
            </div>

            <div class="search-form">
                <div class="form-row">
                    <div class="form-group">
                        <label>Nom</label>
                        <input type="text" id="searchNom" class="form-input" placeholder="Ex: Benali">
                    </div>
                    
                    <div class="form-group">
                        <label>Prénom</label>
                        <input type="text" id="searchPrenom" class="form-input" placeholder="Ex: Ahmed">
                    </div>
                    
                    <div class="form-group">
                        <label>Spécialité</label>
                        <select id="searchSpecialite" class="form-select">
                            <option value="">Toutes les spécialités</option>
                            {% for speciality in specialities %}
                                <option value="{{ speciality.nom }}">{{ speciality.nom }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-group">
                        <button id="btnSearchMedecin" class="btn-search">
                            <i class="fas fa-search"></i>
                            Rechercher
                        </button>
                    </div>
                </div>
            </div>

            <!-- Search Results Container -->
            <div id="searchResultsContainer" class="search-results" style="display: none;">
                <div class="results-header">
                    <h3><i class="fas fa-user-md"></i> Résultats de recherche <span id="resultsCount"></span></h3>
                </div>
                <div id="searchResultsList" class="results-list">
                    <!-- Results will be inserted here dynamically -->
                </div>
            </div>

            {% if lastDoctor %}
                <div class="suggestion-box">
                    <div class="suggestion-content">
                        <div class="suggestion-icon">
                            <i class="fas fa-history"></i>
                        </div>
                        <div class="suggestion-text">
                            <h4>Reprendre rendez-vous ?</h4>
                            <p>Dr. {{ lastDoctor.prenom }} {{ lastDoctor.nom }} ({{ lastDoctor.specialite.nom }})</p>
                        </div>
                    </div>
                    <button class="btn-search suggestion-btn" data-doctor-id="{{ lastDoctor.id }}" data-doctor-name="Dr. {{ lastDoctor.prenom }} {{ lastDoctor.nom }}">
                        <i class="fas fa-calendar-plus"></i> Réserver
                    </button>
                </div>
            {% endif %}
        </div>

        <!-- Appointments Section -->
        <div class="panel">
            <div class="panel-header">
                <h2 class="panel-title">
                    <i class="fas fa-calendar-day"></i>
                    Mes Prochains Rendez-vous
                </h2>
            </div>

            <div class="appointments-list">
                {% if appointments is empty %}
                    <div class="no-appointments">
                        <i class="fas fa-calendar-check"></i>
                        <p>Aucun rendez-vous prévu.</p>
                    </div>
                {% else %}
                    {% for rdv in appointments %}
                        {% if rdv.medecin %}
                        <div class="appointment-card">
                            <div class="appointment-header">
                                <div class="doctor-info">
                                    <h3>Dr. {{ rdv.medecin.prenom }} {{ rdv.medecin.nom }}</h3>
                                    <p class="specialty">
                                        <i class="fas fa-stethoscope"></i>
                                        {{ rdv.medecin.specialite ? rdv.medecin.specialite.nom : 'Médecin' }}
                                    </p>
                                    <p class="appointment-datetime">
                                        <i class="fas fa-calendar"></i>
                                        {{ rdv.dateHeure|date('d/m/Y à H:i') }}
                                    </p>
                                </div>
                                <div class="appointment-status">
                                    {% if rdv.statut == 'confirme' %}
                                        <span class="status-badge confirmed">Confirmé</span>
                                    {% elseif rdv.statut == 'en_attente' %}
                                        <span class="status-badge pending">En Attente</span>
                                    {% elseif rdv.statut == 'termine' %}
                                        <span class="status-badge completed">Terminé</span>
                                    {% elseif rdv.statut == 'annule' %}
                                        <span class="status-badge cancelled">Annulé</span>
                                    {% else %}
                                        <span class="status-badge">{{ rdv.statut }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="appointment-actions">
                                {% if rdv.statut != 'annule' and rdv.statut != 'termine' %}
                                    <button class="action-btn btn-cancel" data-id="{{ rdv.id }}">
                                        <i class="fas fa-times"></i>
                                        Annuler
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </main>

    <!-- Modal: Edit Profile -->
    <div id="editProfileModal" class="modal-overlay">
        <div class="modal-container">
            <!-- Modal Header (Teal with Avatar) -->
            <div class="modal-header-teal">
                <div class="modal-header-content">
                    <div class="modal-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <h2 class="modal-title-white">Éditer Profil & Sécurité</h2>
                </div>
                <button class="modal-close-white" id="closeModalBtn" type="button">&times;</button>
            </div>

            <div class="modal-body-white">
                <form action="{{ path('app_patient_edit_profile') }}" method="POST" id="profileForm">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('patient_edit_profile') }}">
                    
                    <!-- Section: Informations Personnelles -->
                    <div class="section-header-teal">
                        <i class="fas fa-user"></i>
                        <span>Informations Personnelles</span>
                    </div>

                    <div class="form-fields-gray">
                        <div class="field-horizontal">
                            <label class="field-label-left">Nom</label>
                            <input type="text" name="nom" class="field-input-right" value="{{ app.user.nom }}">
                        </div>

                        <div class="field-horizontal">
                            <label class="field-label-left">Prénom</label>
                            <input type="text" name="prenom" class="field-input-right" value="{{ app.user.prenom }}">
                        </div>

                        <div class="field-horizontal">
                            <label class="field-label-left">Téléphone</label>
                            <input type="tel" name="telephone" class="field-input-right" value="{{ app.user.telephone }}">
                        </div>
                    </div>

                    <!-- Section: Changer Mot de Passe -->
                    <div class="section-header-teal">
                        <i class="fas fa-key"></i>
                        <span>Changer Mot de Passe</span>
                    </div>

                    <div class="form-fields-gray">
                        <div class="field-horizontal">
                            <label class="field-label-left">Mot de passe actuel</label>
                            <input type="password" name="current_password" class="field-input-right" placeholder="••••••••">
                        </div>

                        <div class="field-horizontal">
                            <label class="field-label-left">Nouveau mot de passe</label>
                            <input type="password" name="new_password" class="field-input-right" placeholder="••••••••">
                        </div>

                        <div class="field-horizontal">
                            <label class="field-label-left">Confirmer le mot de passe</label>
                            <input type="password" name="confirm_password" class="field-input-right" placeholder="••••••••">
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="modal-buttons">
                        <button type="submit" class="btn-save-teal">
                            <i class="fas fa-save"></i> Enregistrer Tout
                        </button>
                        <button type="button" class="btn-cancel-gray" id="cancelModalBtn">
                            Annuler
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/patient/patient_dashboard.js') }}?v=1"></script>
{% endblock %}