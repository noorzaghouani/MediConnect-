# Fichier d'exemple de configuration environnement pour MediConnect
# Copiez ce fichier vers .env.local et modifiez les valeurs selon votre configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# IMPORTANT: Générez un nouveau secret avec: php bin/console secrets:generate-keys
APP_SECRET=CHANGE_ME_TO_RANDOM_VALUE_GENERATE_WITH_SYMFONY_COMMAND
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format: mysql://user:password@host:port/database?serverVersion=X&charset=utf8mb4
# IMPORTANT: Changez les identifiants par défaut de votre base de données
DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/mediconnect?serverVersion=8&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choisissez l'un des transports ci-dessous
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# IMPORTANT: Configurez votre serveur mail pour l'envoi d'emails
# Exemples:
# - Gmail: smtp://username:password@smtp.gmail.com:587
# - Mailgun: mailgun://KEY:DOMAIN@default?region=eu
# - Sendgrid: sendgrid://KEY@default
MAILER_DSN=null://null
###< symfony/mailer ###
